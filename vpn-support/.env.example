# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Telegram user id администратора (узнать у @userinfobot)
ADMIN_ID=123456789

# Секрет для валидации initData мини-приложения (любая длинная случайная строка)
APP_SECRET=change-me-to-a-long-random-string

# URL мини-приложения (https, нужен для валидации initData)
WEB_APP_URL=https://your-domain.ru

# Порт веб-сервера
PORT=8000

# (Опционально) Путь к базе SQLite — удобно задать в systemd как Environment=DB_PATH=...
# DB_PATH=/opt/vpn-support-data/tickets.db

# (Опционально) Отдельный пароль для панели /admin (по умолчанию = APP_SECRET)
# ADMIN_PANEL_TOKEN=
